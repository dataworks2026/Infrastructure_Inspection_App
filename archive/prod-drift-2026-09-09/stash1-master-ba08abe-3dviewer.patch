+                {selectedDamage.trend === 'new' && (
+                  <span className="text-[8px] font-bold bg-sky-500/15 text-sky-400 px-2 py-0.5 rounded">New Finding</span>
+                )}
+                {selectedDamage.trend === 'stable' && (
