+        <sphereGeometry args={[isSelected ? 0.12 : 0.065, 16, 16]} />
+        <meshPhysicalMaterial color={c} emissive={c} emissiveIntensity={isSelected ? 3 : 0.8}
+          metalness={0.3} roughness={0.3} clearcoat={1} clearcoatRoughness={0.1} />
