+      {/* ── Toe stone (larger stones at base for scour protection) ── */}
+      {Array.from({ length: Math.floor(len / 0.3) }).map((_, i) => (
+        <mesh key={`toe-${i}`}
+          position={[-2.0 + R(i * 3) * 0.15, -1.3 + R(i * 5) * 0.1, -len / 2 + i * 0.3]}
