+              { icon: Download, label: 'Export', action: () => {} },
+              { icon: Share2, label: 'Share', action: () => {} },
+              { icon: Maximize2, label: 'Fullscreen', action: () => {} },
+            ].map(btn => (
+              <button key={btn.label}
