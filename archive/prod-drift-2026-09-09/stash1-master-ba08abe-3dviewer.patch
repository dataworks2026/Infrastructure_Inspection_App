+                  <AlertCircle size={15} /> Failed
+                </span>
+              ) : (
+                <span className="flex items-center gap-1.5 text-sm text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg font-semibold border border-emerald-200">
+                  <CheckCircle size={15} /> Completed
+                </span>
+              )}
+            </div>
