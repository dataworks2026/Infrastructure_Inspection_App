+const TEAL  = '#082E29';
+const BLUE  = '#93C5FD';
+const BRAND = '#0891B2';
+
+const NAV_ITEMS = [
+  { href: '/dashboard',   label: 'Dashboard',   icon: LayoutDashboard, tourId: 'nav-dashboard' },
