+              border: '1px solid rgba(255,255,255,0.08)',
+              color: '#6B9A87',
+            }}
+            title={isCollapsed ? 'Search (⌘K)' : undefined}
+          >
+            <Search size={16} style={{ flexShrink: 0 }} />
+            {!isCollapsed && (
+              <>
+                <span className="text-[12px] font-semibold flex-1 text-left">Search...</span>
